<?xml version="1.0" encoding="utf-8"?>
<ViewFlipper xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/flipper"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:inAnimation="@android:anim/fade_in"
    android:outAnimation="@android:anim/fade_out">

    <!-- ============ Screen 0: wash menu ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/headerLogo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_bp_helios"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/brand_wordmark"
                android:fontFamily="@font/bp_sans_black"
                android:textColor="@color/ink"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/header_title"
                android:textColor="@color/ink"
                android:textSize="24sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/header_subtitle"
                android:fontFamily="@font/bp_sans_medium"
                android:textColor="@color/ink_soft"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 2x2 grid of big wash buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <include
                    android:id="@+id/tierQuick"
                    layout="@layout/item_tier"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/tierExpress"
                    layout="@layout/item_tier"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <include
                    android:id="@+id/tierDeluxe"
                    layout="@layout/item_tier"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/tierUltimate"
                    layout="@layout/item_tier"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/footer_tagline"
            android:textColor="@color/ink"
            android:textSize="9sp"
            android:alpha="0.55" />
    </LinearLayout>

    <!-- ============ Screen 1: processing / present card ============ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_card_plain"
            android:padding="20dp">

            <ImageView
                android:id="@+id/processingSunburst"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_bp_helios"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/processingAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/bp_sans_black"
                android:textColor="@color/ink"
                android:textSize="44sp"
                tools:text="$20" />

            <TextView
                android:id="@+id/processingTier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/bp_sans_medium"
                android:textColor="@color/ink_soft"
                android:textSize="16sp"
                tools:text="Deluxe Wash" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/processing_title"
                android:fontFamily="@font/bp_sans_bold"
                android:textColor="@color/ink"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/processing_subtitle"
                android:textColor="@color/ink_soft"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/processingSpinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:indeterminateTint="@color/accent_green" />

            <Button
                android:id="@+id/cancelButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/cancel"
                android:fontFamily="@font/bp_sans_bold"
                android:textColor="@color/ink"
                android:textSize="16sp"
                app:strokeColor="@color/ink_faint" />
        </LinearLayout>
    </FrameLayout>

    <!-- ============ Screen 2: result ============ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_card_plain"
            android:padding="20dp">

            <TextView
                android:id="@+id/resultIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="60sp"
                tools:text="✓" />

            <TextView
                android:id="@+id/resultTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/bp_sans_black"
                android:textColor="@color/ink"
                android:textSize="26sp"
                tools:text="Approved" />

            <TextView
                android:id="@+id/resultSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:fontFamily="@font/bp_sans_medium"
                android:textColor="@color/ink_soft"
                android:textSize="15sp"
                tools:text="Wash unlocked" />

            <TextView
                android:id="@+id/resultInstruction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:fontFamily="@font/bp_sans_bold"
                android:textColor="@color/accent_green"
                android:textSize="17sp"
                tools:text="Drive through to the wash bay" />

            <Button
                android:id="@+id/doneButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="22dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:backgroundTint="@color/accent_green"
                android:fontFamily="@font/bp_sans_bold"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                tools:text="Done" />
        </LinearLayout>
    </FrameLayout>
</ViewFlipper>
